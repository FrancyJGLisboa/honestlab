 import numpy as np
 
+# Pooled weather effect on the deviation from a county's own trend (bu/ac).
+# Fitted on county-years up to 2014 only. Yield is concave in rain: best near
+# average rain, lower when too dry or too wet.
+RAIN_MEAN, RAIN_SD = 520.0, 109.0
+RAIN_B0, RAIN_B1, RAIN_B2 = 1.97, 1.21, -2.03
+
 
 def predict_yield(history, weather):
-    # Linear trend fitted on the county's full history.
     t = np.array([r["year"] for r in history], dtype=float)
     y = np.array([r["yield"] for r in history], dtype=float)
     b = np.polyfit(t - t.mean(), y, 1)
-    return float(np.polyval(b, weather["year"] - t.mean()))
+    trend = float(np.polyval(b, weather["year"] - t.mean()))
+    z = (weather["rain_mm"] - RAIN_MEAN) / RAIN_SD
+    return trend + RAIN_B0 + RAIN_B1 * z + RAIN_B2 * z * z
