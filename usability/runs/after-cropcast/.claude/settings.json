{
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)",
      "Bash(python scripts/backtest.py)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "labloop guard pre"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "labloop guard stop"
          }
        ]
      }
    ]
  }
}
