+def _ols(X, y):
+    n, k = len(X), len(X[0])
+    A = [[sum(X[i][a] * X[i][b] for i in range(n)) + (1e-6 if a == b else 0) for b in range(k)] for a in range(k)]
+    c = [sum(X[i][a] * y[i] for i in range(n)) for a in range(k)]
+    for i in range(k):
+        p = A[i][i]
+        for j in range(i, k): A[i][j] /= p
+        c[i] /= p
+        for r in range(k):
+            if r != i:
+                f = A[r][i]
+                for j in range(i, k): A[r][j] -= f * A[i][j]
+                c[r] -= f * c[i]
+    return c
+
