@@ -1,4 +1,17 @@
 def predict(history, target):
-    """Average of the same weekday over the last 4 weeks (today's method)."""
-    vals = [h[4] for h in history if h[1] == target[1]][-4:]
-    return sum(vals) / len(vals)
+    """Same-weekday mean of last 4 NON-release days, times a release lift if tomorrow is a release day."""
+    wd, rel = target[1], target[2]
+    base = [h[4] for h in history if h[1] == wd and h[2] == 0][-4:]
+    level = sum(base) / len(base)
+    if not rel:
+        return level
+    r = [h for h in history if h[2] == 1][-12:]
+    n = [h for h in history if h[2] == 0]
+    # ratio of release-day tickets to the typical level on that weekday type
+    ratios = []
+    for h in r:
+        same = [x[4] for x in n if x[1] == h[1] and x[0] < h[0]][-4:]
+        if same:
+            ratios.append(h[4] / (sum(same) / len(same)))
+    lift = sum(ratios) / len(ratios) if ratios else 1.0
+    return level * lift
